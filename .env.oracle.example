# Oracle ingress (Caddy)
DOMAIN=app.example.com
ACME_EMAIL=ops@example.com

# Core server
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_ALLOW_INSECURE_FALLBACK=true
DB_SSL_CA_CERT_BASE64=
JWT_SECRET=change_me_long_random
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Integrations
STRAVA_CLIENT_ID=YOUR_STRAVA_CLIENT_ID
STRAVA_CLIENT_SECRET=YOUR_STRAVA_CLIENT_SECRET
STRAVA_SERVICE_URL=https://your-strava-service.example.com
STRAVA_SERVICE_SECRET=YOUR_STRAVA_SERVICE_SECRET
GARMIN_SERVICE_SECRET=YOUR_GARMIN_SERVICE_SECRET
# garmin-service: Fernet key (base64) encrypting pending MFA state on disk; empty = in-memory only.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GARMIN_STATE_KEY=
# Garmin login strategies can wait up to 20 s each: keep this generous.
GARMIN_SERVICE_TIMEOUT_MS=60000
GARMIN_CORS_ALLOW_ORIGINS=
GARMIN_CORS_ALLOW_CREDENTIALS=false
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Local text LLM (Ollama)
LLM_PROVIDER=gemini
LOCAL_LLM_BASE_URL=http://ollama:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_FALLBACK_MODEL=qwen2.5:3b
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_TIMEOUT_MS=90000
LOCAL_LLM_MAX_TOKENS=900

# Cloud fallback text provider (used only when LLM_PROVIDER=local)
CLOUD_TEXT_FALLBACK_PROVIDER=none
GEMINI_API_KEY=
GEMINI_TEXT_TIMEOUT_MS=30000
# Gemini models (defaults shown). New Google Cloud projects can no longer call gemini-2.5-flash or
# gemini-3-pro-preview; existing projects may keep gemini-2.5-flash by setting GEMINI_TEXT_MODEL.
# GEMINI_MODEL and FORGE_LLM_MODEL are still read as legacy fallbacks for GEMINI_TEXT_MODEL.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_PRO_MODEL=gemini-3-pro-image-preview

# Security / CORS
CRON_SECRET=your-random-cron-secret
TOKEN_ENCRYPTION_KEY=hex:your-64-char-hex-key
# Public origin first (used for email links); https://app.swimforge.it is the Android
# app's WebView origin and must be listed or the app gets 403 origin_not_allowed.
ALLOWED_ORIGINS=https://swimforge.it,https://www.swimforge.it,https://app.swimforge.it
OAUTH_ALLOWED_REDIRECT_ORIGINS=https://app.example.com

# Optional
REDIS_URL=redis://USER:PASSWORD@HOST:PORT
REDIS_REQUIRED_FOR_READY=true
REDIS_RATE_LIMIT_MODE=memory
ROLLBAR_ACCESS_TOKEN=
DEPLOY_TARGET=oracle
APP_RELEASE=
ROLLBAR_SERVER_HOST=
RESEND_API_KEY=
RESEND_FROM_EMAIL=SwimForge <no-reply@example.com>
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ENABLE_SWAGGER=false
CLUB_AI_POST_IMAGE_ENABLED=true
CLUB_AI_POST_IMAGE_MODEL=gpt-image-1

# Client (Vite)
VITE_APP_ID=swimforge
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_CLUB_MEETS_V1_ENABLED=false
VITE_CLUB_HISTORY_V1_ENABLED=false
VITE_CLUB_AI_AUTOMATION_V1_ENABLED=false
