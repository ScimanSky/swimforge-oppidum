# Vite env for the native (Capacitor) build: `pnpm build:native` (vite build --mode native).
# Copy to `.env.native` (git-ignored). Vite reads env files from the repo root (envDir in vite.config.ts).
# The WebView origin is https://app.swimforge.it, so API calls must use the absolute backend URL.
VITE_API_BASE_URL=https://swimforge.it
# Same public values as the web build (the Supabase anon key is public by design).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
