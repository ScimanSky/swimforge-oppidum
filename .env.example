# Server
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
JWT_SECRET=change_me_long_random
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Integrations
STRAVA_CLIENT_ID=YOUR_STRAVA_CLIENT_ID
STRAVA_CLIENT_SECRET=YOUR_STRAVA_CLIENT_SECRET
GARMIN_SERVICE_URL=https://your-garmin-service
GARMIN_SERVICE_SECRET=YOUR_GARMIN_SERVICE_SECRET
# Text AI (local on Oracle with Ollama)
LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=http://ollama:11434/v1
LOCAL_LLM_MODEL=qwen3:8b
LOCAL_LLM_FALLBACK_MODEL=qwen3:4b
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_TIMEOUT_MS=45000
LOCAL_LLM_MAX_TOKENS=700

# Legacy cloud text provider (optional, keep empty when local)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
FORGE_LLM_MODEL=qwen3:8b
CLUB_WORKOUTS_AI_MODEL=qwen3:8b
CLUB_WORKOUTS_AI_MODEL_PRIMARY=qwen3:8b
CLUB_WORKOUTS_AI_MODEL_ESCALATION=qwen3:4b
CLUB_BRANDING_AI_ENABLED=true
CLUB_BRANDING_AI_MODEL=gpt-image-1

# Tunables
GEMINI_API_TIMEOUT_MS=60000
CLUB_WORKOUTS_AI_TIMEOUT_MS=45000
CLUB_WORKOUTS_AI_REQUEST_TIMEOUT_SOFT_MS=30000
CLUB_WORKOUTS_AI_QUALITY_THRESHOLD=0.92
EXTERNAL_API_TIMEOUT_MS=30000
GARMIN_SERVICE_TIMEOUT_MS=15000

# Optional
REDIS_URL=redis://USER:PASSWORD@HOST:PORT
ROLLBAR_ACCESS_TOKEN=
SENTRY_DSN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=SwimForge <no-reply@your-domain.com>
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_VIDEO_CREDIT_WARN_PERCENT=80
CLOUDINARY_VIDEO_CREDIT_BLOCK_PERCENT=95

# Cron and Security
CRON_SECRET=your-random-cron-secret
TOKEN_ENCRYPTION_KEY=hex:your-64-char-hex-key
ALLOWED_ORIGINS=https://your-app.onrender.com
CSP_CONNECT_SRC_EXTRA=
CSP_IMG_SRC_EXTRA=
CSP_MEDIA_SRC_EXTRA=
SESSION_MAX_AGE_DAYS=30
POST_DELETE_WINDOW_HOURS=24
NOTIFICATION_RETENTION_DAYS=90
DM_RETENTION_DAYS=60
SOCIAL_RETENTION_BATCH_LIMIT=1000
ADMIN_IP=
ENABLE_SWAGGER=false
CLUB_MEETS_V1_ENABLED=false
CLUB_HISTORY_V1_ENABLED=false
CLUB_AI_AUTOMATION_ENABLED=false
CLUB_AI_DEFAULT_CLUB_IDS=13
CLUB_AI_TIMEZONE=Europe/Rome
CLUB_AI_POST_IMAGE_ENABLED=true
CLUB_AI_POST_IMAGE_MODEL=gpt-image-1

# Client (Vite)
VITE_APP_ID=swimforge
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_ANALYTICS_ENDPOINT=https://your-analytics-endpoint
VITE_ANALYTICS_WEBSITE_ID=your-site-id
VITE_IMAGEKIT_PUBLIC_KEY=
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
VITE_DM_RETENTION_DAYS=60
VITE_CLUB_MEETS_V1_ENABLED=false
VITE_CLUB_HISTORY_V1_ENABLED=false
VITE_CLUB_AI_AUTOMATION_V1_ENABLED=false
