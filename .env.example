# Server
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_ALLOW_INSECURE_FALLBACK=true
DB_SSL_CA_CERT_BASE64=
JWT_SECRET=change_me_long_random
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Integrations
STRAVA_CLIENT_ID=YOUR_STRAVA_CLIENT_ID
STRAVA_CLIENT_SECRET=YOUR_STRAVA_CLIENT_SECRET
GARMIN_SERVICE_URL=https://your-garmin-service
GARMIN_SERVICE_SECRET=YOUR_GARMIN_SERVICE_SECRET
# garmin-service: Fernet key (base64) encrypting pending MFA state on disk; empty = in-memory only.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GARMIN_STATE_KEY=
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Gemini models (defaults shown). New Google Cloud projects can no longer call gemini-2.5-flash or
# gemini-3-pro-preview; existing projects may keep gemini-2.5-flash by setting GEMINI_TEXT_MODEL.
# GEMINI_MODEL and FORGE_LLM_MODEL are still read as legacy fallbacks for GEMINI_TEXT_MODEL.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_PRO_MODEL=gemini-3-pro-image-preview
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Optional per-feature overrides (default: GEMINI_TEXT_MODEL / GEMINI_PRO_MODEL)
# FORGE_LLM_MODEL=
# CLUB_WORKOUTS_AI_MODEL_PRIMARY=
# CLUB_WORKOUTS_AI_MODEL_ESCALATION=
CLUB_BRANDING_AI_ENABLED=true
CLUB_BRANDING_AI_MODEL=gpt-image-1

# Tunables
GEMINI_API_TIMEOUT_MS=60000
CLUB_WORKOUTS_AI_TIMEOUT_MS=45000
CLUB_WORKOUTS_AI_REQUEST_TIMEOUT_SOFT_MS=30000
CLUB_WORKOUTS_AI_QUALITY_THRESHOLD=0.92
# Garmin login strategies can wait up to 20 s each: keep this generous.
GARMIN_SERVICE_TIMEOUT_MS=60000
EXTERNAL_API_TIMEOUT_MS=30000

# Optional
REDIS_URL=redis://USER:PASSWORD@HOST:PORT
REDIS_REQUIRED_FOR_READY=true
REDIS_RATE_LIMIT_MODE=memory
ROLLBAR_ACCESS_TOKEN=
DEPLOY_TARGET=render
APP_RELEASE=
ROLLBAR_SERVER_HOST=
RESEND_API_KEY=
RESEND_FROM_EMAIL=SwimForge <no-reply@your-domain.com>
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_VIDEO_CREDIT_WARN_PERCENT=80
CLOUDINARY_VIDEO_CREDIT_BLOCK_PERCENT=95

# Cron and Security
CRON_SECRET=your-random-cron-secret
TOKEN_ENCRYPTION_KEY=hex:your-64-char-hex-key
# Public origin first; add https://app.swimforge.it (Android app WebView origin) in production.
ALLOWED_ORIGINS=https://your-app.onrender.com
CSP_CONNECT_SRC_EXTRA=
CSP_IMG_SRC_EXTRA=
CSP_MEDIA_SRC_EXTRA=
SESSION_MAX_AGE_DAYS=30
POST_DELETE_WINDOW_HOURS=24
NOTIFICATION_RETENTION_DAYS=90
DM_RETENTION_DAYS=365
SOCIAL_RETENTION_BATCH_LIMIT=1000
ADMIN_IP=

# Push notifications (FCM, Android app). Base64 of the Firebase service-account JSON
# (project swimforge-oppidum, role with FCM send permission): base64 -w0 service-account.json
# Empty = push disabled (one warning at startup).
FIREBASE_SERVICE_ACCOUNT_JSON=
ENABLE_SWAGGER=false
CLUB_MEETS_V1_ENABLED=false
CLUB_HISTORY_V1_ENABLED=false
CLUB_AI_AUTOMATION_ENABLED=false
CLUB_AI_DEFAULT_CLUB_IDS=13
CLUB_AI_TIMEZONE=Europe/Rome
CLUB_AI_POST_IMAGE_ENABLED=true
CLUB_AI_POST_IMAGE_MODEL=gemini-3-pro-image-preview

# Client (Vite)
VITE_APP_ID=swimforge
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_ANALYTICS_ENDPOINT=https://your-analytics-endpoint
VITE_ANALYTICS_WEBSITE_ID=your-site-id
VITE_IMAGEKIT_PUBLIC_KEY=
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
VITE_DM_RETENTION_DAYS=365
VITE_CLUB_MEETS_V1_ENABLED=false
VITE_CLUB_HISTORY_V1_ENABLED=false
VITE_CLUB_AI_AUTOMATION_V1_ENABLED=false
