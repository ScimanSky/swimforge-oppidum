{
  "name": "swimforge-frontend",
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:native": "vite build --mode native && node scripts/prune-native-bundle.mjs",
    "android:sync": "npx cap sync android",
    "android:build": "pnpm build:native && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:open": "npx cap open android",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "docs:generate": "typedoc --entryPoints server/_core/index.ts --out docs/api",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run",
    "secrets:scan": "node scripts/check-secrets.mjs",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:validate": "node scripts/validate-drizzle-chain.mjs"
  },
